# =============================================================================
# .gitattributes —— 固定行尾，避免"Windows 检出成 CRLF → 上传到 Linux → bash 报
#                    $'\r': command not found" 这类问题。
#
# 背景：本机全局设了 core.autocrlf=true，而本仓库的用途之一是把代码上传到
# Linux 云实例跑训练。靠 core.autocrlf 这种"本机配置"决定行尾是不可靠的：
# 仓库里 git 存的是 LF（已用 `git ls-files --eol` 核实：i/crlf 为 0），
# 但工作区检出后 *.sh 会变成 CRLF，再拷到 Linux 就直接不能执行。
# 用 .gitattributes 把规则写进仓库，任何机器、任何 core.autocrlf 下行为都一致。
# =============================================================================

# 默认：文本文件一律以 LF 存储与检出
* text=auto eol=lf

# 明确指定（上面已覆盖，这里显式列出以便阅读）
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.tsv   text eol=lf
*.wrd   text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cff   text eol=lf
*.service text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Windows 批处理必须用 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制：不做任何行尾转换（也不要尝试 diff/merge）
*.pt     binary
*.pth    binary
*.ckpt   binary
*.bin    binary
*.npz    binary
*.npy    binary
*.pkl    binary
*.wav    binary
*.mp3    binary
*.flac   binary
*.mp4    binary
*.mkv    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.gz     binary
*.bz2    binary
*.xz     binary
*.zip    binary
*.tar    binary
*.tgz    binary
*.so     binary
*.dll    binary
*.exe    binary
*.dat    binary
*.model  binary
